# PVL Commerce backend environment
# Copy this file to `.env` and fill in real values before starting the server.

# HTTP server port
PORT=5000

# ---------- PostgreSQL ----------
# Preferred: full connection string
DATABASE_URL=

# Legacy discrete variables (used if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pvl_commerce
DB_USER=postgres
DB_PASSWORD=

# ---------- Auth ----------
# Long, random string used to sign JWTs
JWT_SECRET=

# ---------- Razorpay (test mode uses rzp_test_* keys) ----------
# From Razorpay Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Razorpay Dashboard → Account & Settings → Webhooks → Create webhook
# NEVER expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the client.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Business rules ----------
# Set to 'true' to allow Cash on Delivery
COD_ENABLED=true

# Default delivery fee (paise) if a store's delivery_fee is 0
DEFAULT_DELIVERY_FEE=2500

# Minimum order in paise (0 to disable)
MIN_ORDER=0

# ---------- Optional / future ----------
MAPS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMS_API_KEY=
EMAIL_API_KEY=
STORAGE_PROVIDER=
