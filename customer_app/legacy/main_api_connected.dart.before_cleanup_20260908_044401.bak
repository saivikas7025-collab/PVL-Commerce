                  Row(children: [Text('₹${product.price}', style: const TextStyle(fontSize: 25, fontWeight: FontWeight.w900)), const SizedBox(width: 8), Text('₹${product.mrp}', style: const TextStyle(color: textGrey, decoration: TextDecoration.lineThrough))]),
                  const SizedBox(height: 14),
                  Row(children: [Chip(avatar: const Icon(Icons.star_rounded, size: 16, color: Color(0xFFF3B51B)), label: Text('${product.rating}')), const SizedBox(width: 8), Chip(avatar: const Icon(Icons.schedule_rounded, size: 16), label: Text('${product.delivery} min'))]),
                  const SizedBox(height: 12),
                  const Divider(),
                  const SizedBox(height: 10),
                  const Text('About this product', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w900)),
                  const SizedBox(height: 7),
                  Text('Fresh and carefully selected ${product.name.toLowerCase()} from trusted local stores. Quality products delivered conveniently to your doorstep.', style: const TextStyle(color: textGrey, height: 1.5)),
                  const SizedBox(height: 18),
                  Container(width: double.infinity, padding: const EdgeInsets.all(14), decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(14)), child: const Row(children: [Icon(Icons.delivery_dining_rounded, color: primaryGreen, size: 30), SizedBox(width: 10), Expanded(child: Text('Fast local delivery with live order updates.', style: TextStyle(fontWeight: FontWeight.w800)))])),
                ],
              ),
            ),
          ],
        ),
      ),
      bottomNavigationBar: SafeArea(
        child: Container(
          padding: const EdgeInsets.all(12),
          color: Colors.white,
          child: Row(
            children: [
              if (quantity > 0)
                Container(height: 50, decoration: BoxDecoration(color: lightGreen, border: Border.all(color: primaryGreen), borderRadius: BorderRadius.circular(12)), child: Row(children: [IconButton(onPressed: onRemove, icon: const Icon(Icons.remove, color: primaryGreen)), Text('$quantity', style: const TextStyle(color: primaryGreen, fontWeight: FontWeight.w900)), IconButton(onPressed: onAdd, icon: const Icon(Icons.add, color: primaryGreen))]))
              else
                OutlinedButton(onPressed: onAdd, style: OutlinedButton.styleFrom(foregroundColor: primaryGreen, side: const BorderSide(color: primaryGreen), fixedSize: const Size(75, 50)), child: const Text('ADD')),
              const SizedBox(width: 10),
              Expanded(child: ElevatedButton(onPressed: onAdd, style: buttonStyle().copyWith(minimumSize: const WidgetStatePropertyAll(Size.fromHeight(50))), child: const Text('Add to Cart'))),
            ],
          ),
        ),
      ),
    );
  }
}

class AddressPage extends StatefulWidget {
  final List<Address> addresses;
  const AddressPage({super.key, required this.addresses});
  @override State<AddressPage> createState() => _AddressPageState();
}
class _AddressPageState extends State<AddressPage> {
  Address? selected;
  @override void initState() { super.initState(); selected = widget.addresses.where((a) => a.isDefault).firstOrNull ?? (widget.addresses.isEmpty ? null : widget.addresses.first); }
  void addEdit([Address? old]) async {
    final result = await Navigator.push<Address>(context, MaterialPageRoute(builder: (_) => AddressFormPage(address: old)));
    if (result == null) return;
    setState(() { if (old != null) { final i = widget.addresses.indexOf(old); if (i >= 0) widget.addresses[i] = result; } else { widget.addresses.add(result); } if (result.isDefault) for (final a in widget.addresses) { if (a != result) a.isDefault = false; } selected = result; });
  }
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Delivery Address', style: TextStyle(fontWeight: FontWeight.w900))),
      body: widget.addresses.isEmpty
          ? const EmptyState(icon: Icons.location_on_outlined, title: 'No saved addresses', subtitle: 'Add an address to continue')
          : ListView(
              padding: const EdgeInsets.all(16),
              children: [
                for (final a in widget.addresses) addressCard(a),
                const SizedBox(height: 8),
                OutlinedButton.icon(onPressed: addEdit, icon: const Icon(Icons.add), label: const Text('Add New Address')),
                const SizedBox(height: 12),
                OutlinedButton.icon(onPressed: () => ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Location permission and maps will be connected next.'))), icon: const Icon(Icons.my_location_rounded), label: const Text('Use Current Location')),
              ],
            ),
      bottomNavigationBar: SafeArea(child: Padding(padding: const EdgeInsets.all(14), child: ElevatedButton(onPressed: selected == null ? null : () => Navigator.pop(context, selected), style: buttonStyle(), child: const Text('Deliver to This Address')))),
    );
  }
  Widget addressCard(Address a) {
    return GestureDetector(
      onTap: () => setState(() => selected = a),
      child: Container(
        margin: const EdgeInsets.only(bottom: 10),
        padding: const EdgeInsets.all(14),
        decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: selected == a ? primaryGreen : borderGrey, width: selected == a ? 1.5 : 1)),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Icon(a.label == 'Work' ? Icons.business_rounded : Icons.home_rounded, color: primaryGreen),
            const SizedBox(width: 10),
            Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Row(children: [Text(a.label.toUpperCase(), style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 11)), if (a.isDefault) Container(margin: const EdgeInsets.only(left: 7), padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 3), decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(5)), child: const Text('DEFAULT', style: TextStyle(color: primaryGreen, fontSize: 8, fontWeight: FontWeight.w900))), const Spacer(), PopupMenuButton<String>(onSelected: (v) { if (v == 'edit') addEdit(a); if (v == 'delete') setState(() { widget.addresses.remove(a); if (selected == a) selected = widget.addresses.isEmpty ? null : widget.addresses.first; }); }, itemBuilder: (_) => const [PopupMenuItem(value: 'edit', child: Text('Edit')), PopupMenuItem(value: 'delete', child: Text('Delete'))])]),
              Text(a.name, style: const TextStyle(fontWeight: FontWeight.w800)),
              const SizedBox(height: 3),
              Text(a.fullAddress, style: const TextStyle(color: textGrey, fontSize: 12, height: 1.4)),
              Text(a.phone, style: const TextStyle(color: textGrey, fontSize: 11)),
            ])),
            Radio<Address>(value: a, groupValue: selected, activeColor: primaryGreen, onChanged: (v) => setState(() => selected = v)),
          ],
        ),
      ),
    );
  }
  ButtonStyle buttonStyle() => ElevatedButton.styleFrom(backgroundColor: primaryGreen, foregroundColor: Colors.white, elevation: 0, minimumSize: const Size.fromHeight(50), shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(13)));
}

class AddressFormPage extends StatefulWidget {
  final Address? address;
  const AddressFormPage({super.key, this.address});
  @override State<AddressFormPage> createState() => _AddressFormPageState();
}
class _AddressFormPageState extends State<AddressFormPage> {
  late final TextEditingController name, phone, house, street, landmark, city, state, pin;
  String label = 'Home'; bool defaultAddress = false;
  @override void initState() { super.initState(); final a = widget.address; name = TextEditingController(text: a?.name ?? ''); phone = TextEditingController(text: a?.phone ?? ''); house = TextEditingController(text: a?.house ?? ''); street = TextEditingController(text: a?.street ?? ''); landmark = TextEditingController(text: a?.landmark ?? ''); city = TextEditingController(text: a?.city ?? 'Kurnool'); state = TextEditingController(text: a?.state ?? 'Andhra Pradesh'); pin = TextEditingController(text: a?.pin ?? ''); label = a?.label ?? 'Home'; defaultAddress = a?.isDefault ?? false; }
  @override void dispose() { for (final c in [name, phone, house, street, landmark, city, state, pin]) { c.dispose(); } super.dispose(); }
  void save() { if ([name, phone, house, street, city, state, pin].any((c) => c.text.trim().isEmpty)) { ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Please complete all required fields.'))); return; } if (phone.text.replaceAll(RegExp(r'\D'), '').length < 10 || pin.text.replaceAll(RegExp(r'\D'), '').length != 6) { ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Enter a valid mobile number and 6-digit PIN code.'))); return; } Navigator.pop(context, Address(label: label, name: name.text.trim(), phone: phone.text.trim(), house: house.text.trim(), street: street.text.trim(), landmark: landmark.text.trim(), city: city.text.trim(), state: state.text.trim(), pin: pin.text.trim(), isDefault: defaultAddress)); }
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(widget.address == null ? 'Add New Address' : 'Edit Address', style: const TextStyle(fontWeight: FontWeight.w900))),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          Text('Location', style: sectionStyle()),
          const SizedBox(height: 8),
          OutlinedButton.icon(onPressed: () => ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Map picker will be connected next.'))), icon: const Icon(Icons.location_on_outlined), label: const Text('Search location / Use current location')),
          const SizedBox(height: 18),
          Text('Address details', style: sectionStyle()),
          const SizedBox(height: 8),
          field(name, 'Full Name', Icons.person_outline),
          field(phone, 'Mobile Number', Icons.phone_outlined, type: TextInputType.phone),
          field(house, 'House / Flat / Building', Icons.home_outlined),
          field(street, 'Street / Area', Icons.route_outlined),
          field(landmark, 'Landmark (Optional)', Icons.place_outlined),
          field(city, 'City', Icons.location_city_outlined),
          field(state, 'State', Icons.map_outlined),
          field(pin, 'PIN Code', Icons.pin_drop_outlined, type: TextInputType.number),
          const SizedBox(height: 10),
          Text('Save address as', style: sectionStyle()),
          const SizedBox(height: 8),
          Row(children: ['Home', 'Work', 'Other'].map((x) => Expanded(child: Padding(padding: const EdgeInsets.only(right: 6), child: ChoiceChip(label: Text(x), selected: label == x, onSelected: (_) => setState(() => label = x))))).toList()),
          SwitchListTile(contentPadding: EdgeInsets.zero, value: defaultAddress, activeColor: primaryGreen, onChanged: (v) => setState(() => defaultAddress = v), title: const Text('Make this my default address', style: TextStyle(fontWeight: FontWeight.w700))),
          const SizedBox(height: 14),
          ElevatedButton(onPressed: save, style: ElevatedButton.styleFrom(backgroundColor: primaryGreen, foregroundColor: Colors.white, minimumSize: const Size.fromHeight(52), shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(13))), child: const Text('SAVE ADDRESS', style: TextStyle(fontWeight: FontWeight.w900))),
        ],
      ),
    );
  }
  TextStyle sectionStyle() => const TextStyle(fontSize: 16, fontWeight: FontWeight.w900);
  Widget field(TextEditingController c, String hint, IconData icon, {TextInputType? type}) => Padding(padding: const EdgeInsets.only(bottom: 10), child: TextField(controller: c, keyboardType: type, decoration: InputDecoration(prefixIcon: Icon(icon), labelText: hint, border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)))));
}

class CheckoutPage extends StatefulWidget {
  final List<Product> products; final Map<String, int> cart; final Address? address; final List<Address> addresses;
  const CheckoutPage({super.key, required this.products, required this.cart, required this.address, required this.addresses});
  @override State<CheckoutPage> createState() => _CheckoutPageState();
}
class _CheckoutPageState extends State<CheckoutPage> {
  Address? address; String payment = 'UPI'; String delivery = 'Standard';
  @override void initState() { super.initState(); address = widget.address; }
  int get subtotal => widget.products.fold(0, (s, p) => s + p.price * (widget.cart[p.name] ?? 0));
  int get fee => delivery == 'Express' ? 39 : subtotal >= 199 ? 0 : 25;
  int get discount => subtotal >= 500 ? 50 : 0;
  int get total => subtotal + fee - discount;
  Future<void> chooseAddress() async { final a = await Navigator.push<Address>(context, MaterialPageRoute(builder: (_) => AddressPage(addresses: widget.addresses))); if (a != null) setState(() => address = a); }
  void placeOrder() { if (address == null) { ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Please select a delivery address.'))); return; } final id = '#PVL${1000 + DateTime.now().millisecond}'; final o = OrderModel(id: id, date: DateTime.now(), products: widget.products, quantities: widget.cart, total: total, address: address!, payment: payment, delivery: delivery, status: 'Order confirmed'); Navigator.push(context, MaterialPageRoute(builder: (_) => OrderConfirmationPage(order: o))).then((_) => Navigator.pop(context, o)); }
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Checkout', style: TextStyle(fontWeight: FontWeight.w900))),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          const Text('Delivery address', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w900)),
          const SizedBox(height: 8),
          GestureDetector(onTap: chooseAddress, child: Container(padding: const EdgeInsets.all(15), decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: borderGrey)), child: Row(children: [const Icon(Icons.home_rounded, color: primaryGreen), const SizedBox(width: 10), Expanded(child: Text(address == null ? 'Add delivery address' : '${address!.name}\n${address!.fullAddress}', style: const TextStyle(fontSize: 12, height: 1.4, fontWeight: FontWeight.w600))), const Text('CHANGE', style: TextStyle(color: primaryGreen, fontSize: 10, fontWeight: FontWeight.w900))]))),
          const SizedBox(height: 20),
          const Text('Delivery option', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w900)),
          option('Standard', '30–60 minutes', fee == 0 ? 'FREE' : '₹25', Icons.local_shipping_outlined),
          option('Express', '15–30 minutes', '₹39', Icons.bolt_rounded),
          const SizedBox(height: 20),
          const Text('Order items', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w900)),
          Container(
            margin: const EdgeInsets.only(top: 8),
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: borderGrey)),
            child: Column(
              children: [
                for (final p in widget.products)
                  ListTile(
                    contentPadding: EdgeInsets.zero,
                    leading: Container(width: 48, height: 48, decoration: BoxDecoration(color: const Color(0xFFF3F5F2), borderRadius: BorderRadius.circular(10)), child: Icon(p.icon, color: textGrey)),
                    title: Text(p.name, style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 12)),
                    subtitle: Text('${p.unit} × ${widget.cart[p.name]}'),
                    trailing: Text('₹${p.price * (widget.cart[p.name] ?? 0)}', style: const TextStyle(fontWeight: FontWeight.w900)),
                  ),
              ],
            ),
          ),
          const SizedBox(height: 20),
          const Text('Payment method', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w900)),
          optionPayment('UPI', 'Google Pay, PhonePe, Paytm and more', Icons.account_balance_wallet_outlined),
          optionPayment('Cash on delivery', 'Pay when your order arrives', Icons.payments_outlined),
          optionPayment('Card', 'Credit or debit card', Icons.credit_card_outlined),
          const SizedBox(height: 20),
          const Text('Bill details', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w900)),
          Container(margin: const EdgeInsets.only(top: 8), padding: const EdgeInsets.all(16), decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: borderGrey)), child: Column(children: [_row('Item total', '₹$subtotal'), _row('Delivery', fee == 0 ? 'FREE' : '₹$fee', color: fee == 0 ? primaryGreen : textDark), if (discount > 0) _row('Discount', '-₹$discount', color: primaryGreen), const Divider(height: 20), _row('Total', '₹$total', large: true)])),
          const SizedBox(height: 20),
        ],
      ),
      bottomNavigationBar: SafeArea(child: Padding(padding: const EdgeInsets.all(14), child: Row(children: [Column(crossAxisAlignment: CrossAxisAlignment.start, mainAxisSize: MainAxisSize.min, children: [const Text('Total', style: TextStyle(color: textGrey, fontSize: 10)), Text('₹$total', style: const TextStyle(fontSize: 19, fontWeight: FontWeight.w900))]), const SizedBox(width: 15), Expanded(child: ElevatedButton(onPressed: placeOrder, style: buttonStyle(), child: const Text('PLACE ORDER', style: TextStyle(fontWeight: FontWeight.w900))))]))),
    );
  }
  Widget option(String value, String sub, String price, IconData icon) {
    return GestureDetector(
      onTap: () => setState(() => delivery = value),
      child: Container(margin: const EdgeInsets.only(top: 8), padding: const EdgeInsets.all(12), decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(15), border: Border.all(color: delivery == value ? primaryGreen : borderGrey, width: delivery == value ? 1.5 : 1)), child: Row(children: [Icon(icon, color: primaryGreen), const SizedBox(width: 10), Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(value == 'Standard' ? 'Standard delivery' : 'Express delivery', style: const TextStyle(fontWeight: FontWeight.w800)), Text(sub, style: const TextStyle(color: textGrey, fontSize: 10))])), Text(price, style: const TextStyle(fontWeight: FontWeight.w900)), Radio<String>(value: value, groupValue: delivery, activeColor: primaryGreen, onChanged: (v) => setState(() => delivery = v!))])),
    );
  }
  Widget optionPayment(String value, String sub, IconData icon) {
    return GestureDetector(
      onTap: () => setState(() => payment = value),
      child: Container(margin: const EdgeInsets.only(top: 8), padding: const EdgeInsets.all(12), decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(15), border: Border.all(color: payment == value ? primaryGreen : borderGrey, width: payment == value ? 1.5 : 1)), child: Row(children: [Icon(icon, color: primaryGreen), const SizedBox(width: 10), Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(value, style: const TextStyle(fontWeight: FontWeight.w800)), Text(sub, style: const TextStyle(color: textGrey, fontSize: 10))])), Radio<String>(value: value, groupValue: payment, activeColor: primaryGreen, onChanged: (v) => setState(() => payment = v!))])),
    );
  }
  Widget _row(String a, String b, {Color? color, bool large = false}) => Row(children: [Expanded(child: Text(a, style: TextStyle(color: large ? textDark : textGrey, fontWeight: large ? FontWeight.w900 : FontWeight.w500))), Text(b, style: TextStyle(color: color ?? textDark, fontWeight: FontWeight.w900, fontSize: large ? 18 : 12))]);
}

class OrderConfirmationPage extends StatelessWidget {
  final OrderModel order;
  const OrderConfirmationPage({super.key, required this.order});
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: Center(
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Container(width: 90, height: 90, decoration: const BoxDecoration(color: lightGreen, shape: BoxShape.circle), child: const Icon(Icons.check_rounded, color: primaryGreen, size: 55)),
                const SizedBox(height: 20),
                const Text('Order Confirmed!', style: TextStyle(fontSize: 26, fontWeight: FontWeight.w900)),
                const SizedBox(height: 8),
                Text(order.id, style: const TextStyle(color: primaryGreen, fontWeight: FontWeight.w900)),
                const SizedBox(height: 10),
                Text('Your order of ₹${order.total} has been placed successfully. Estimated delivery: ${order.delivery == 'Express' ? '15–30' : '30–60'} minutes.', textAlign: TextAlign.center, style: const TextStyle(color: textGrey, height: 1.5)),
                const SizedBox(height: 24),
                Container(width: double.infinity, padding: const EdgeInsets.all(16), decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: borderGrey)), child: Column(children: [Text(order.address.fullAddress, textAlign: TextAlign.center, style: const TextStyle(fontSize: 12, height: 1.4)), const SizedBox(height: 8), Text('Payment: ${order.payment}', style: const TextStyle(color: textGrey, fontSize: 11))])),
                const SizedBox(height: 20),
                SizedBox(width: double.infinity, height: 50, child: ElevatedButton(onPressed: () => Navigator.pop(context), style: buttonStyle(), child: const Text('CONTINUE'))),
                const SizedBox(height: 8),
                TextButton(onPressed: () => Navigator.push(context, MaterialPageRoute(builder: (_) => OrderTrackingPage(order: order))), child: const Text('Track Order')),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class OrderTrackingPage extends StatefulWidget {
  final OrderModel order;
  const OrderTrackingPage({super.key, required this.order});
  @override State<OrderTrackingPage> createState() => _OrderTrackingPageState();
}
class _OrderTrackingPageState extends State<OrderTrackingPage> {
  int step = 1;
  @override Widget build(BuildContext context) => Scaffold(appBar: AppBar(title: const Text('Track Order', style: TextStyle(fontWeight: FontWeight.w900))), body: ListView(padding: const EdgeInsets.all(16), children: [Container(padding: const EdgeInsets.all(18), decoration: BoxDecoration(gradient: const LinearGradient(colors: [darkGreen, primaryGreen]), borderRadius: BorderRadius.circular(18)), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(widget.order.id, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w900)), const SizedBox(height: 8), const Text('Arriving soon', style: TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.w900)), Text(widget.order.delivery == 'Express' ? '15–30 minutes' : '30–60 minutes', style: const TextStyle(color: Colors.white70))])), const SizedBox(height: 18), Container(padding: const EdgeInsets.all(16), decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(18), border: Border.all(color: borderGrey)), child: Column(children: [_trackStep('Order placed', 'We received your order', Icons.receipt_long_rounded, true), _trackStep('Store preparing', 'Your items are being packed', Icons.inventory_2_rounded, step >= 1), _trackStep('Out for delivery', 'Delivery partner is on the way', Icons.delivery_dining_rounded, step >= 2), _trackStep('Delivered', 'Enjoy your order', Icons.check_circle_rounded, step >= 3)])), const SizedBox(height: 16), Container(padding: const EdgeInsets.all(15), decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(15)), child: Row(children: [const Icon(Icons.location_on_rounded, color: primaryGreen), const SizedBox(width: 8), Expanded(child: Text(widget.order.address.fullAddress, style: const TextStyle(fontSize: 11, height: 1.4)))])), const SizedBox(height: 16), OutlinedButton(onPressed: () { setState(() { step = step >= 3 ? 1 : step + 1; }); }, child: const Text('SIMULATE NEXT STATUS'))]));
  Widget _trackStep(String title, String sub, IconData icon, bool active) => Padding(padding: const EdgeInsets.only(bottom: 18), child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [Container(width: 42, height: 42, decoration: BoxDecoration(color: active ? lightGreen : const Color(0xFFF3F3F3), shape: BoxShape.circle), child: Icon(icon, color: active ? primaryGreen : textGrey, size: 21)), const SizedBox(width: 12), Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(title, style: TextStyle(fontWeight: FontWeight.w900, color: active ? textDark : textGrey)), const SizedBox(height: 3), Text(sub, style: const TextStyle(color: textGrey, fontSize: 11))]))]));
}

class WishlistPage extends StatelessWidget {
  final Set<String> favorites; final ValueChanged<String> onRemove; final ValueChanged<Product> onAdd;
  const WishlistPage({super.key, required this.favorites, required this.onRemove, required this.onAdd});
  @override
  Widget build(BuildContext context) {
    final list = products.where((p) => favorites.contains(p.name)).toList();
    return Scaffold(
      appBar: AppBar(title: const Text('Wishlist', style: TextStyle(fontWeight: FontWeight.w900))),
      body: list.isEmpty
          ? const EmptyState(icon: Icons.favorite_border_rounded, title: 'Your wishlist is empty', subtitle: 'Save products you love')
          : GridView.builder(
              padding: const EdgeInsets.all(16),
              itemCount: list.length,
              gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(crossAxisCount: 2, crossAxisSpacing: 10, mainAxisSpacing: 10, mainAxisExtent: 280),
              itemBuilder: (_, i) {
                final p = list[i];
                return Container(
                  padding: const EdgeInsets.all(10),
                  decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: borderGrey)),
                  child: Column(
                    children: [
                      Expanded(child: Icon(p.icon, size: 65, color: textGrey)),
                      Text(p.name, style: const TextStyle(fontWeight: FontWeight.w900)),
                      Text(p.unit, style: const TextStyle(color: textGrey, fontSize: 10)),
                      const SizedBox(height: 4),
                      Text('₹${p.price}', style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 16)),
                      const SizedBox(height: 8),
                      Row(
                        children: [
                          Expanded(child: OutlinedButton(onPressed: () => onRemove(p.name), child: const Text('Remove'))),
                          const SizedBox(width: 5),
                          Expanded(
                            child: ElevatedButton(
                              onPressed: () {
                                onAdd(p);
                                ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Added to cart')));
                              },
                              style: ElevatedButton.styleFrom(backgroundColor: primaryGreen, foregroundColor: Colors.white),
                              child: const Text('Add'),
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                );
              },
            ),
    );
  }
}

class NotificationsPage extends StatelessWidget {
  const NotificationsPage({super.key});
  @override
