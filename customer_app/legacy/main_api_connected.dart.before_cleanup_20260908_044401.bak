class PVLCommerceApp extends StatelessWidget {
  const PVLCommerceApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'PVL-Commerce',
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: background,
        colorScheme: ColorScheme.fromSeed(seedColor: primaryGreen),
      ),
      home: const MainScreen(),
    );
  }
}

class MainScreen extends StatefulWidget {
  const MainScreen({super.key});
  @override
  State<MainScreen> createState() => _MainScreenState();
}

class _MainScreenState extends State<MainScreen> {
  int tab = 0;
  String category = 'All';
  String search = '';
  final cart = <String, int>{};
  final favorites = <String>{};
  final addresses = <Address>[
    Address(label: 'Home', name: 'Sai Vikas', phone: '+91 98765 43210', house: '12-34', street: 'Example Street', landmark: 'Near Main Road', city: 'Kurnool', state: 'Andhra Pradesh', pin: '518001', isDefault: true),
  ];
  final orders = <OrderModel>[];
  bool loadingProducts = true;
  String productError = '';

  @override
  void initState() {
    super.initState();
    loadProducts();
  }

  Future<void> loadProducts() async {
    try {
      final response = await http.get(
        Uri.parse('http://localhost:5000/api/products'),
      );
      if (response.statusCode != 200) {
        throw Exception('Server returned ${response.statusCode}');
      }
      final data = jsonDecode(response.body) as Map<String, dynamic>;
      final rows = (data['products'] as List<dynamic>? ?? []);
      final loaded = rows
          .map((item) => Product.fromJson(item as Map<String, dynamic>))
          .toList();
      if (!mounted) return;
      setState(() {
        products = loaded;
        loadingProducts = false;
        productError = '';
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        loadingProducts = false;
        productError = 'Unable to load products. Please check that the backend is running.';
      });
    }
  }

  Widget productsSection() {
    if (loadingProducts) {
      return const Center(
        child: Padding(
          padding: EdgeInsets.all(30),
          child: CircularProgressIndicator(),
        ),
      );
    }
    if (productError.isNotEmpty) {
      return Center(
        child: Padding(
          padding: const EdgeInsets.all(20),
          child: Column(
            children: [
              const Icon(Icons.cloud_off_rounded, size: 42, color: textGrey),
              const SizedBox(height: 8),
              Text(productError, textAlign: TextAlign.center, style: const TextStyle(color: textGrey)),
              const SizedBox(height: 10),
              OutlinedButton(onPressed: () { setState(() { loadingProducts = true; productError = ''; }); loadProducts(); }, child: const Text('RETRY')),
            ],
          ),
        ),
      );
    }
    if (visibleProducts.isEmpty) {
      return const EmptyState(icon: Icons.search_off_rounded, title: 'No products found', subtitle: 'Try another search or category');
    }
    return productGrid(visibleProducts);
  }

  int get cartCount => cart.values.fold(0, (a, b) => a + b);
  int get subtotal => products.fold(0, (sum, p) => sum + p.price * (cart[p.name] ?? 0));
  Address? get defaultAddress {
    for (final a in addresses) { if (a.isDefault) return a; }
    return addresses.isEmpty ? null : addresses.first;
  }

  List<Product> get visibleProducts => products.where((p) {
    final c = category == 'All' || p.category == category;
    final s = search.trim().isEmpty || p.name.toLowerCase().contains(search.toLowerCase());
    return c && s;
  }).toList();

  void add(Product p) => setState(() => cart[p.name] = (cart[p.name] ?? 0) + 1);
  void remove(Product p) => setState(() {
    final q = cart[p.name] ?? 0;
    if (q <= 1) { cart.remove(p.name); } else { cart[p.name] = q - 1; }
  });

  void openProduct(Product p) {
    Navigator.push(context, MaterialPageRoute(builder: (_) => ProductDetailsPage(
      product: p,
      quantity: cart[p.name] ?? 0,
      favorite: favorites.contains(p.name),
      onFavorite: () => setState(() {
        if (!favorites.add(p.name)) favorites.remove(p.name);
      }),
      onAdd: () => add(p),
      onRemove: () => remove(p),
    )));
  }

  void openAddresses({bool fromCheckout = false}) async {
    final result = await Navigator.push<Address>(context, MaterialPageRoute(builder: (_) => AddressPage(addresses: addresses)));
    if (result != null) {
      setState(() {
        for (final a in addresses) { a.isDefault = false; }
        result.isDefault = true;
        if (!addresses.contains(result)) addresses.add(result);
      });
    }
  }

  void checkout() async {
    if (cart.isEmpty) return;
    final items = products.where((p) => (cart[p.name] ?? 0) > 0).toList();
    final selected = defaultAddress;
    final order = await Navigator.push<OrderModel>(context, MaterialPageRoute(builder: (_) => CheckoutPage(
      products: items,
      cart: Map<String, int>.from(cart),
      address: selected,
      addresses: addresses,
    )));
    if (order != null) {
      setState(() {
        orders.insert(0, order);
        cart.clear();
        tab = 3;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: IndexedStack(index: tab, children: [home(), categoriesPage(), cartPage(), ordersPage(), profilePage()]),
      bottomNavigationBar: NavigationBar(
        height: 70,
        selectedIndex: tab,
        onDestinationSelected: (i) => setState(() => tab = i),
        indicatorColor: lightGreen,
        destinations: [
          const NavigationDestination(icon: Icon(Icons.home_outlined), selectedIcon: Icon(Icons.home_rounded, color: primaryGreen), label: 'Home'),
          const NavigationDestination(icon: Icon(Icons.grid_view_outlined), selectedIcon: Icon(Icons.grid_view_rounded, color: primaryGreen), label: 'Categories'),
          NavigationDestination(icon: Badge(isLabelVisible: cartCount > 0, label: Text('$cartCount'), child: const Icon(Icons.shopping_cart_outlined)), selectedIcon: Badge(isLabelVisible: cartCount > 0, label: Text('$cartCount'), child: const Icon(Icons.shopping_cart_rounded, color: primaryGreen)), label: 'Cart'),
          const NavigationDestination(icon: Icon(Icons.receipt_long_outlined), selectedIcon: Icon(Icons.receipt_long_rounded, color: primaryGreen), label: 'Orders'),
          const NavigationDestination(icon: Icon(Icons.person_outline_rounded), selectedIcon: Icon(Icons.person_rounded, color: primaryGreen), label: 'Profile'),
        ],
      ),
    );
  }

  Widget home() {
    return SafeArea(child: Column(children: [
      header(),
      Expanded(child: SingleChildScrollView(padding: const EdgeInsets.all(16), child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        searchBox(),
        const SizedBox(height: 18),
        SizedBox(height: 90, child: ListView(scrollDirection: Axis.horizontal, children: [
          categoryChip('All', Icons.apps_rounded),
          ...categoryData.map((c) => categoryChip(c['name'] as String, c['icon'] as IconData)),
        ])),
        const SizedBox(height: 15),
        Container(width: double.infinity, padding: const EdgeInsets.all(20), decoration: BoxDecoration(gradient: const LinearGradient(colors: [darkGreen, Color(0xFF35A64C)]), borderRadius: BorderRadius.circular(20)), child: Row(children: [
          const Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text('Fresh groceries', style: TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.w900)), SizedBox(height: 4), Text('Delivered to your doorstep', style: TextStyle(color: Colors.white70)), SizedBox(height: 12), Text('FREE DELIVERY ABOVE ₹199', style: TextStyle(color: Colors.white, fontSize: 10, fontWeight: FontWeight.w900))])),
          const Icon(Icons.shopping_basket_rounded, color: Colors.white, size: 65),
        ])),
        const SizedBox(height: 20),
        Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [const Text('Popular products', style: TextStyle(fontSize: 20, fontWeight: FontWeight.w900)), TextButton(onPressed: () => setState(() => tab = 1), child: const Text('View all'))]),
        const SizedBox(height: 8),
        productGrid(visibleProducts),
      ]))),
    ]));
  }

  Widget header() => Container(color: Colors.white, padding: const EdgeInsets.fromLTRB(16, 10, 10, 10), child: Row(children: [
    Container(width: 42, height: 42, decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(13)), child: const Icon(Icons.location_on_rounded, color: primaryGreen)),
    const SizedBox(width: 10),
    Expanded(child: GestureDetector(onTap: openAddresses, child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [const Text('DELIVER TO', style: TextStyle(fontSize: 9, color: textGrey, fontWeight: FontWeight.w800)), const SizedBox(height: 2), Row(children: [Flexible(child: Text(defaultAddress?.city ?? 'Select location', overflow: TextOverflow.ellipsis, style: const TextStyle(fontWeight: FontWeight.w900))), const Icon(Icons.keyboard_arrow_down_rounded, size: 18)])]))),
    IconButton(onPressed: () => Navigator.push(context, MaterialPageRoute(builder: (_) => const NotificationsPage())), icon: const Icon(Icons.notifications_none_rounded)),
    Stack(children: [IconButton(onPressed: () => setState(() => tab = 2), icon: const Icon(Icons.shopping_cart_outlined)), if (cartCount > 0) Positioned(right: 4, top: 2, child: CircleAvatar(radius: 8, backgroundColor: primaryGreen, child: Text('$cartCount', style: const TextStyle(color: Colors.white, fontSize: 8))))]),
  ]));

  Widget searchBox() => Container(height: 52, decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(15), border: Border.all(color: borderGrey)), child: TextField(onChanged: (v) => setState(() => search = v), decoration: const InputDecoration(border: InputBorder.none, prefixIcon: Icon(Icons.search_rounded), hintText: 'Search products, groceries and more')));

  Widget categoryChip(String name, IconData icon) => GestureDetector(onTap: () => setState(() => category = name), child: Container(width: 76, margin: const EdgeInsets.only(right: 10), child: Column(children: [Container(width: 62, height: 62, decoration: BoxDecoration(color: category == name ? lightGreen : Colors.white, border: Border.all(color: category == name ? primaryGreen : borderGrey), borderRadius: BorderRadius.circular(18)), child: Icon(icon, color: category == name ? primaryGreen : textGrey)), const SizedBox(height: 6), Text(name, maxLines: 1, overflow: TextOverflow.ellipsis, style: const TextStyle(fontSize: 10, fontWeight: FontWeight.w700))])));

  Widget productGrid(List<Product> list) => LayoutBuilder(builder: (context, box) {
    final columns = box.maxWidth >= 1000 ? 4 : box.maxWidth >= 700 ? 3 : 2;
    return GridView.builder(shrinkWrap: true, physics: const NeverScrollableScrollPhysics(), itemCount: list.length, gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(crossAxisCount: columns, crossAxisSpacing: 10, mainAxisSpacing: 12, mainAxisExtent: 310), itemBuilder: (_, i) {
      final p = list[i];
      return ProductCard(product: p, quantity: cart[p.name] ?? 0, favorite: favorites.contains(p.name), onTap: () => openProduct(p), onAdd: () => add(p), onRemove: () => remove(p), onFavorite: () => setState(() { if (!favorites.add(p.name)) favorites.remove(p.name); }));
    });
  });

  Widget categoriesPage() => SafeArea(child: Column(children: [pageHeader('Categories', 'Shop everything you need'), Expanded(child: GridView.builder(padding: const EdgeInsets.all(16), itemCount: categoryData.length, gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(crossAxisCount: 2, crossAxisSpacing: 12, mainAxisSpacing: 12, mainAxisExtent: 135), itemBuilder: (_, i) { final c = categoryData[i]; return InkWell(onTap: () { setState(() { category = c['name'] as String; tab = 0; }); }, borderRadius: BorderRadius.circular(18), child: Container(decoration: cardDecoration(), child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [Container(width: 56, height: 56, decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(16)), child: Icon(c['icon'] as IconData, color: primaryGreen)), const SizedBox(height: 8), Text(c['name'] as String, style: const TextStyle(fontWeight: FontWeight.w800))]))); }))]));

  Widget cartPage() {
    final items = products.where((p) => (cart[p.name] ?? 0) > 0).toList();
    return SafeArea(child: Column(children: [pageHeader('Your Cart', '$cartCount items'), if (items.isEmpty) const Expanded(child: EmptyState(icon: Icons.shopping_cart_outlined, title: 'Your cart is empty', subtitle: 'Add products to get started')) else Expanded(child: Column(children: [Expanded(child: ListView.builder(padding: const EdgeInsets.all(16), itemCount: items.length, itemBuilder: (_, i) => cartItem(items[i])),), cartSummary()]))]));
  }

  Widget cartItem(Product p) => Container(margin: const EdgeInsets.only(bottom: 10), padding: const EdgeInsets.all(10), decoration: cardDecoration(), child: Row(children: [Container(width: 68, height: 68, decoration: BoxDecoration(color: const Color(0xFFF3F5F2), borderRadius: BorderRadius.circular(13)), child: Icon(p.icon, color: textGrey, size: 32)), const SizedBox(width: 10), Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(p.name, style: const TextStyle(fontWeight: FontWeight.w900)), Text(p.unit, style: const TextStyle(color: textGrey, fontSize: 11)), const SizedBox(height: 4), Text('₹${p.price}', style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 16))])), quantityControl(p)]));

  Widget quantityControl(Product p) => Container(height: 34, decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(9), border: Border.all(color: primaryGreen)), child: Row(mainAxisSize: MainAxisSize.min, children: [IconButton(onPressed: () => remove(p), padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 32), icon: const Icon(Icons.remove, size: 16, color: primaryGreen)), Text('${cart[p.name] ?? 0}', style: const TextStyle(fontWeight: FontWeight.w900, color: primaryGreen)), IconButton(onPressed: () => add(p), padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 32), icon: const Icon(Icons.add, size: 16, color: primaryGreen))]));

  Widget cartSummary() { final fee = subtotal >= 199 ? 0 : 25; final discount = subtotal >= 500 ? 50 : 0; final total = subtotal + fee - discount; return Container(padding: const EdgeInsets.fromLTRB(16, 13, 16, 15), decoration: BoxDecoration(color: Colors.white, boxShadow: [BoxShadow(color: Colors.black.withOpacity(.06), blurRadius: 15, offset: const Offset(0, -3))]), child: Column(children: [_billRow('Subtotal', '₹$subtotal'), _billRow('Delivery', fee == 0 ? 'FREE' : '₹$fee', color: fee == 0 ? primaryGreen : textDark), if (discount > 0) _billRow('Discount', '-₹$discount', color: primaryGreen), const Divider(height: 18), _billRow('Total', '₹$total', large: true), const SizedBox(height: 10), SizedBox(width: double.infinity, height: 50, child: ElevatedButton(onPressed: checkout, style: buttonStyle(), child: const Text('Proceed to Checkout')))])); }

  Widget ordersPage() => SafeArea(child: Column(children: [pageHeader('My Orders', '${orders.length} order${orders.length == 1 ? '' : 's'}'), Expanded(child: orders.isEmpty ? const EmptyState(icon: Icons.receipt_long_outlined, title: 'No orders yet', subtitle: 'Your completed orders will appear here') : ListView.builder(padding: const EdgeInsets.all(16), itemCount: orders.length, itemBuilder: (_, i) => orderTile(orders[i])))]));

  Widget orderTile(OrderModel o) => Container(margin: const EdgeInsets.only(bottom: 12), padding: const EdgeInsets.all(15), decoration: cardDecoration(), child: Column(children: [Row(children: [Container(width: 45, height: 45, decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(12)), child: const Icon(Icons.shopping_bag_rounded, color: primaryGreen)), const SizedBox(width: 10), Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(o.id, style: const TextStyle(fontWeight: FontWeight.w900)), const SizedBox(height: 3), Text('${o.products.length} item(s) • ${o.payment}', style: const TextStyle(color: textGrey, fontSize: 11))])), Text('₹${o.total}', style: const TextStyle(fontWeight: FontWeight.w900))]), const SizedBox(height: 12), Row(children: [Expanded(child: Text(o.status, style: const TextStyle(color: primaryGreen, fontWeight: FontWeight.w800))), TextButton(onPressed: () => Navigator.push(context, MaterialPageRoute(builder: (_) => OrderTrackingPage(order: o))), child: const Text('Track')), ElevatedButton(onPressed: () { for (final p in o.products) { cart[p.name] = (cart[p.name] ?? 0) + (o.quantities[p.name] ?? 0); } setState(() => tab = 2); }, style: buttonStyle(), child: const Text('Shop Again'))]) ]));

  Widget profilePage() {
    return SafeArea(
      child: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(20),
              decoration: cardDecoration(),
              child: Column(
                children: [
                  const CircleAvatar(
                    radius: 38,
                    backgroundColor: lightGreen,
                    child: Icon(Icons.person_rounded, color: primaryGreen, size: 42),
                  ),
                  const SizedBox(height: 10),
                  const Text('Welcome to PVL-Commerce', style: TextStyle(fontSize: 19, fontWeight: FontWeight.w900)),
                  const SizedBox(height: 4),
                  const Text('Login to manage your account', style: TextStyle(color: textGrey)),
                  const SizedBox(height: 14),
                  SizedBox(
                    width: double.infinity,
                    height: 46,
                    child: ElevatedButton(onPressed: loginDialog, style: buttonStyle(), child: const Text('Login / Sign Up')),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 12),
            profileOption(Icons.location_on_outlined, 'My Addresses', 'Manage delivery addresses', openAddresses),
            profileOption(Icons.favorite_border_rounded, 'Wishlist', '${favorites.length} saved products', () {
              Navigator.push(context, MaterialPageRoute(builder: (_) => WishlistPage(
                favorites: favorites,
                onRemove: (n) => setState(() => favorites.remove(n)),
                onAdd: add,
              )));
            }),
            profileOption(Icons.notifications_none_rounded, 'Notifications', 'Offers and order updates', () {
              Navigator.push(context, MaterialPageRoute(builder: (_) => const NotificationsPage()));
            }),
            profileOption(Icons.help_outline_rounded, 'Help & Support', 'Get help with your orders', helpDialog),
            profileOption(Icons.info_outline_rounded, 'About PVL-Commerce', 'Version 1.0.0', () {
              showAboutDialog(context: context, applicationName: 'PVL-Commerce', applicationVersion: '1.0.0');
            }),
          ],
        ),
      ),
    );
  }

  Widget profileOption(IconData icon, String title, String sub, VoidCallback onTap) => Container(margin: const EdgeInsets.only(bottom: 10), decoration: cardDecoration(), child: ListTile(onTap: onTap, leading: Container(width: 44, height: 44, decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(12)), child: Icon(icon, color: primaryGreen)), title: Text(title, style: const TextStyle(fontWeight: FontWeight.w800)), subtitle: Text(sub, style: const TextStyle(color: textGrey, fontSize: 11)), trailing: const Icon(Icons.chevron_right_rounded)));

  Widget pageHeader(String title, String sub) => Container(color: Colors.white, padding: const EdgeInsets.fromLTRB(16, 15, 16, 14), child: Row(children: [Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [Text(title, style: const TextStyle(fontSize: 21, fontWeight: FontWeight.w900)), Text(sub, style: const TextStyle(color: textGrey, fontSize: 11))]))]));

  Widget _billRow(String a, String b, {Color? color, bool large = false}) => Row(children: [Expanded(child: Text(a, style: TextStyle(color: large ? textDark : textGrey, fontSize: large ? 15 : 12, fontWeight: large ? FontWeight.w900 : FontWeight.w500))), Text(b, style: TextStyle(color: color ?? textDark, fontSize: large ? 18 : 12, fontWeight: FontWeight.w900))]);

  BoxDecoration cardDecoration() => BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: borderGrey));
  ButtonStyle buttonStyle() => ElevatedButton.styleFrom(backgroundColor: primaryGreen, foregroundColor: Colors.white, elevation: 0, shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)));

  void loginDialog() { final c = TextEditingController(); showDialog(context: context, builder: (_) => AlertDialog(title: const Text('Login / Sign Up'), content: TextField(controller: c, keyboardType: TextInputType.phone, decoration: const InputDecoration(prefixText: '+91 ', hintText: 'Mobile number', border: OutlineInputBorder())), actions: [TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')), ElevatedButton(onPressed: () { Navigator.pop(context); ScaffoldMessenger.of(this.context).showSnackBar(const SnackBar(content: Text('OTP flow will be connected to the backend next.'))); }, child: const Text('Send OTP'))])); }
  void helpDialog() { showDialog(context: context, builder: (_) => AlertDialog(title: const Text('Help & Support'), content: const Text('For the MVP, support is shown here. Later this will connect to chat, tickets and order-specific support.'), actions: [TextButton(onPressed: () => Navigator.pop(context), child: const Text('Close'))])); }
}

class ProductCard extends StatelessWidget {
  final Product product; final int quantity; final bool favorite; final VoidCallback onTap, onAdd, onRemove, onFavorite;
  const ProductCard({super.key, required this.product, required this.quantity, required this.favorite, required this.onTap, required this.onAdd, required this.onRemove, required this.onFavorite});
  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: borderGrey)),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            SizedBox(
              height: 135,
              child: Stack(
                children: [
                  Center(child: Container(width: 94, height: 94, decoration: BoxDecoration(color: const Color(0xFFF3F5F2), borderRadius: BorderRadius.circular(18)), child: Icon(product.icon, size: 55, color: textGrey))),
                  if (product.discount > 0)
                    Positioned(left: 8, top: 8, child: Container(padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 4), decoration: BoxDecoration(color: primaryGreen, borderRadius: BorderRadius.circular(7)), child: Text('${product.discount}% OFF', style: const TextStyle(color: Colors.white, fontSize: 9, fontWeight: FontWeight.w900)))),
                  Positioned(right: 5, top: 5, child: IconButton(onPressed: onFavorite, icon: Icon(favorite ? Icons.favorite_rounded : Icons.favorite_border_rounded, color: favorite ? Colors.redAccent : textDark), iconSize: 19)),
                ],
              ),
            ),
            Padding(
              padding: const EdgeInsets.fromLTRB(10, 0, 10, 9),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(product.unit, style: const TextStyle(color: textGrey, fontSize: 10)),
                  const SizedBox(height: 3),
                  Text(product.name, maxLines: 1, overflow: TextOverflow.ellipsis, style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 13)),
                  const SizedBox(height: 5),
                  Row(children: [Text('₹${product.price}', style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 16)), const SizedBox(width: 5), Text('₹${product.mrp}', style: const TextStyle(color: textGrey, fontSize: 10, decoration: TextDecoration.lineThrough))]),
                  const SizedBox(height: 5),
                  Row(children: [const Icon(Icons.star_rounded, size: 14, color: Color(0xFFF3B51B)), const SizedBox(width: 2), Text('${product.rating}', style: const TextStyle(fontSize: 10, fontWeight: FontWeight.w700)), const Spacer(), Text('${product.delivery} min', style: const TextStyle(color: textGrey, fontSize: 9))]),
                  const SizedBox(height: 8),
                  SizedBox(
                    height: 34,
                    width: double.infinity,
                    child: quantity == 0
                        ? OutlinedButton(onPressed: onAdd, style: OutlinedButton.styleFrom(foregroundColor: primaryGreen, side: const BorderSide(color: primaryGreen), shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(9)), padding: EdgeInsets.zero), child: const Text('ADD', style: TextStyle(fontWeight: FontWeight.w900, fontSize: 11)))
                        : Container(decoration: BoxDecoration(color: lightGreen, borderRadius: BorderRadius.circular(9), border: Border.all(color: primaryGreen)), child: Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [IconButton(onPressed: onRemove, padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 34), icon: const Icon(Icons.remove, size: 15, color: primaryGreen)), Text('$quantity', style: const TextStyle(color: primaryGreen, fontWeight: FontWeight.w900)), IconButton(onPressed: onAdd, padding: EdgeInsets.zero, constraints: const BoxConstraints(minWidth: 34), icon: const Icon(Icons.add, size: 15, color: primaryGreen))])),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

