import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(const PVLCommerceApp());

// ============================================================
// PVL-COMMERCE CUSTOMER MVP
// Local/demo data only. Backend, OTP, maps and payments come later.
// ============================================================


const darkGreen = Color(0xFF176B2B);
const lightGreen = Color(0xFFEAF7ED);
const background = Color(0xFFF7F8F6);


const borderGrey = Color(0xFFE3E7E3);

const Color primaryGreen = Color(0xFF16A34A);
const Color textDark = Color(0xFF111827);
const Color textGrey = Color(0xFF6B7280);

ButtonStyle buttonStyle() {
  return ElevatedButton.styleFrom(
    backgroundColor: primaryGreen,
    foregroundColor: Colors.white,
    elevation: 0,
    shape: RoundedRectangleBorder(
      borderRadius: BorderRadius.circular(12),
    ),
    padding: const EdgeInsets.symmetric(
      horizontal: 18,
      vertical: 14,
    ),
  );
}

class Product {
  final int id;
  final String name;
  final String description;
  final int price;
  final int mrp;
  final String unit;
  final String category;
  final IconData icon;
  final double rating;
  final int delivery;
  final int stock;

  const Product({
    required this.id,
    required this.name,
    required this.description,
    required this.price,
    required this.mrp,
    required this.unit,
    required this.category,
    required this.icon,
    required this.rating,
    required this.delivery,
    required this.stock,
  });

  int get discount => mrp > 0 ? ((mrp - price) * 100 ~/ mrp) : 0;

  factory Product.fromJson(Map<String, dynamic> json) {
    final category = (json['category_name'] ?? 'Other').toString();
    return Product(
      id: int.tryParse(json['id'].toString()) ?? 0,
      name: (json['name'] ?? 'Product').toString(),
      description: (json['description'] ?? '').toString(),
      price: double.tryParse(json['price'].toString())?.round() ?? 0,
      mrp: double.tryParse(json['original_price'].toString())?.round() ?? 0,
      unit: (json['unit'] ?? '').toString(),
      category: category,
      icon: _iconForCategory(category),
      rating: 4.5,
      delivery: 30,
      stock: 99,
    );
  }
}

IconData _iconForCategory(String category) {
  switch (category.toLowerCase()) {
    case 'fruits':
      return Icons.eco_rounded;
    case 'vegetables':
      return Icons.local_florist_rounded;
    case 'dairy':
      return Icons.local_drink_rounded;
    case 'bakery':
      return Icons.bakery_dining_rounded;
    case 'eggs':
      return Icons.egg_alt_rounded;
    case 'rice & grains':
      return Icons.shopping_bag_rounded;
    case 'beverages':
      return Icons.local_drink_outlined;
    case 'household':
      return Icons.cleaning_services_rounded;
    case 'personal care':
      return Icons.spa_rounded;
    default:
      return Icons.shopping_basket_rounded;
  }
}

List<Product> products = [];

class Address {
  String label;
  String name;
  String phone;
  String house;
  String street;
  String landmark;
  String city;
  String state;
  String pin;
  bool isDefault;

  Address({
    required this.label,
    required this.name,
    required this.phone,
    required this.house,
    required this.street,
    required this.landmark,
    required this.city,
    required this.state,
    required this.pin,
    this.isDefault = false,
  });

  String get fullAddress =>
      '$house, $street${landmark.isEmpty ? '' : ', $landmark'}, $city, $state - $pin';
}

class OrderModel {
  final String id;
  final DateTime date;
  final List<Product> products;
  final Map<String, int> quantities;
  final int total;
  final Address address;
  final String payment;
  final String delivery;
  String status;

  OrderModel({
    required this.id,
    required this.date,
    required this.products,
    required this.quantities,
    required this.total,
    required this.address,
    required this.payment,
    required this.delivery,
    required this.status,
  });
}

const products = <Product>[
  Product(name: 'Fresh Milk', price: 60, mrp: 65, unit: '500 ml', category: 'Dairy', icon: Icons.local_drink_rounded, rating: 4.6, delivery: 16, stock: 8),
  Product(name: 'Fresh Bread', price: 45, mrp: 50, unit: '1 pack', category: 'Bakery', icon: Icons.bakery_dining_rounded, rating: 4.5, delivery: 16, stock: 6),
  Product(name: 'Rice', price: 350, mrp: 390, unit: '5 kg', category: 'Groceries', icon: Icons.shopping_bag_rounded, rating: 4.7, delivery: 18, stock: 5),
  Product(name: 'Biscuits', price: 30, mrp: 35, unit: '1 pack', category: 'Snacks', icon: Icons.cookie_rounded, rating: 4.4, delivery: 15, stock: 12),
  Product(name: 'Soft Drink', price: 40, mrp: 45, unit: '750 ml', category: 'Drinks', icon: Icons.local_drink_outlined, rating: 4.3, delivery: 15, stock: 10),
  Product(name: 'Dish Wash', price: 85, mrp: 99, unit: '500 ml', category: 'Cleaning', icon: Icons.cleaning_services_rounded, rating: 4.5, delivery: 17, stock: 7),
  Product(name: 'Hand Wash', price: 70, mrp: 80, unit: '250 ml', category: 'Personal Care', icon: Icons.sanitizer_rounded, rating: 4.6, delivery: 16, stock: 9),
  Product(name: 'Potato Chips', price: 35, mrp: 40, unit: '1 pack', category: 'Snacks', icon: Icons.fastfood_rounded, rating: 4.5, delivery: 15, stock: 15),
  Product(name: 'Toor Dal', price: 145, mrp: 165, unit: '1 kg', category: 'Groceries', icon: Icons.rice_bowl_rounded, rating: 4.6, delivery: 18, stock: 5),
  Product(name: 'Cooking Oil', price: 155, mrp: 175, unit: '1 L', category: 'Groceries', icon: Icons.water_drop_rounded, rating: 4.5, delivery: 18, stock: 6),
  Product(name: 'Apples', price: 120, mrp: 140, unit: '1 kg', category: 'Fruits', icon: Icons.apple_rounded, rating: 4.7, delivery: 20, stock: 5),
  Product(name: 'Bananas', price: 55, mrp: 65, unit: '1 dozen', category: 'Fruits', icon: Icons.eco_rounded, rating: 4.6, delivery: 20, stock: 8),
];

const categoryData = <Map<String, dynamic>>[
  {'name': 'Fruits', 'icon': Icons.eco_rounded},
  {'name': 'Vegetables', 'icon': Icons.local_florist_rounded},
  {'name': 'Dairy', 'icon': Icons.local_drink_rounded},
  {'name': 'Bakery', 'icon': Icons.bakery_dining_rounded},
  {'name': 'Eggs', 'icon': Icons.egg_alt_rounded},
  {'name': 'Rice & Grains', 'icon': Icons.shopping_bag_rounded},
  {'name': 'Beverages', 'icon': Icons.local_drink_outlined},
  {'name': 'Household', 'icon': Icons.cleaning_services_rounded},
  {'name': 'Personal Care', 'icon': Icons.spa_rounded},
